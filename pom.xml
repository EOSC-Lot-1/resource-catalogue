    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>gr.uoa.di.madgik</groupId>
    <artifactId>resource-catalogue</artifactId>
    <version>5.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <modules>
        <module>resource-catalogue-model</module>
        <module>resource-catalogue-model-lot1</module>
        <module>resource-catalogue-api</module>
        <module>resource-catalogue-rest</module>
        <module>resource-catalogue-service</module>
        <module>matomo</module>
        <module>resource-catalogue-elastic</module>
        <module>resource-catalogue-jms</module>
